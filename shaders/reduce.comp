#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer BufIn  { float in_data[]; };
layout(set = 0, binding = 1) buffer BufOut { float out_data[]; };

layout(push_constant) uniform PushConstants {
    uint n;
};

shared float sdata[256];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint gid = gl_GlobalInvocationID.x;

    sdata[tid] = (gid < n) ? in_data[gid] : 0.0;
    barrier();

    for (uint s = 128; s > 0; s >>= 1) {
        if (tid < s) {
            sdata[tid] += sdata[tid + s];
        }
        barrier();
    }

    if (tid == 0) {
        out_data[gl_WorkGroupID.x] = sdata[0];
    }
}
